# Pipeline nộp bài KHÔNG dùng API key hay dịch vụ inference ngoài.
# Các biến dưới đây chỉ phục vụ công cụ phát triển chạy ở máy, không bao giờ
# được đọc bởi predict-v2 hay notebook Kaggle.

# Dùng cho: medical-coder label-gpt  (gán nhãn giả, tách hẳn khỏi đường chạy nộp bài)
OPENAI_API_KEY=sk-...

# Đường dẫn tài nguyên khi chạy trên Kaggle, truyền thẳng cho CLI thì tiện hơn.
LOCAL_MODEL_PATH=/kaggle/input/qwen3-8b
ICD_KB_PATH=/kaggle/input/medical-terminology/icd10.tsv
RXNORM_KB_PATH=/kaggle/input/medical-terminology/rxnorm.tsv
